# PostgreSQL connection (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/procease_auction?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seat release: how long a controlling vendor session's disconnect is tolerated
# before the seat is released to another login from the same company.
# Not specified by the spec (flagged in §17) — defaulted to the spec's own
# suggested value. Revisit if this causes disputes.
SEAT_RELEASE_TIMEOUT_SEC=60

# Notifications — leave unset to fall back to a console-log adapter (dev/local).
EMAIL_PROVIDER=console        # console | resend | brevo
EMAIL_API_KEY=
EMAIL_FROM="auctions@procease.local"

SMS_PROVIDER=console          # console | msg91 | fast2sms
SMS_API_KEY=
SMS_SENDER_ID=PROCZE
